{
  "name": "nebula-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "prepare": "simple-git-hooks",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"app/**/*.{css,vue}\"",
    "lint:style:fix": "stylelint \"app/**/*.{css,vue}\" --fix",
    "knip": "knip",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "npm run lint && npm run lint:style && npm run typecheck && npm run test && npm run check:i18n && npm run knip",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/azeret-mono": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@nuxtjs/i18n": "^10.6.0",
    "nuxt": "^4.6.2",
    "three": "^0.186.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@nuxt/eslint": "1.17.0",
    "@types/node": "24.19.2",
    "@types/three": "^0.186.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.13.0",
    "knip": "6.42.0",
    "nano-staged": "1.0.2",
    "postcss-html": "2.0.0",
    "simple-git-hooks": "2.14.0",
    "stylelint": "17.16.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "nano-staged": {
    "*.{js,mjs,ts,vue}": "eslint --fix",
    "*.{css,vue}": "stylelint --fix"
  },
  "simple-git-hooks": {
    "pre-commit": "npx nano-staged",
    "pre-push": "npm run typecheck && npm test"
  }
}
