            "description": "内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "处理登出：鉴权前置由 [`FirstPartyUser`] 提取器承担——无有效 access token 时\nhandler 根本不会执行（v3 的登出路由没挂鉴权，撤销逻辑永不执行，红线 #1）；\ncookie 来源的写请求同时过 CSRF 门禁（ADR-0005）。",
        "description": "# Errors\n未认证 401；撤销失败 500。",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "已撤销全部会话并清除 cookie"
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "CSRF 校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
