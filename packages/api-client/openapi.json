    "/api/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "处理刷新：CSRF 门禁（cookie-only 写端点，ADR-0005）→ 呈递 cookie 中的\nrefresh 明文 → 原子轮转 → 续发 access 与新 csrf。\n401/403 附带清 cookie 头：安全不依赖它（服务端已撤销），但不清会让浏览器\n揣着死 cookie 重放最长 30 天，污染 401 指标与日志（§9.8），也拖累盗用恢复体验。",
        "description": "# Errors\nCSRF 校验失败 403 `csrf_invalid`；cookie 缺失/未知/过期 401 `refresh_invalid`；\n重放 401 `refresh_reused`（家族已整族撤销）；内部故障 500。",
        "operationId": "refresh",
        "responses": {
          "204": {
            "description": "轮转成功，新凭据经 Set-Cookie 下发"
          },
          "401": {
            "description": "refresh token 缺失、无效或重放",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "CSRF 校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
