  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "description": "错误响应体；所有非 2xx 响应共用此形状。`details` 是唯一扩展位，\n携带结构化附加数据（如字段级校验错误）。",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "机器可读错误码，跨版本稳定（如 `internal_error`）。"
          },
          "details": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Value",
                "description": "结构化附加数据；无则为 `None`，序列化时省略。"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string",
            "description": "英文诊断文本（陈述式，小写开头、无尾标点），供日志与排查；\n不得直接展示给终端用户。"
          }
        }
      },
      "FieldInvalid": {
        "type": "object",
        "description": "单个字段校验失败；`code` 机器可读（如 `password_too_short`），\n前端按 `field` + `code` 取本地化文案。",
        "required": [
          "field",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "该字段的机器可读错误码。"
